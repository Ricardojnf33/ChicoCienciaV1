# Modelos / Provedores
OPENAI_API_KEY=changeme

# Modelos (ajuste aos seus)
MODEL_TEXT=gpt-4.1-mini
MODEL_VISION=gpt-4o-mini

# Parâmetros do ATS
MAX_BRANCHING=3
MAX_DEPTH=4
EARLY_STOP_SCORE=0.72

# Paths
DATA_ROOT=./data
ARTIFACT_ROOT=./experiments
SQLITE_URL=sqlite:///runs.db

# Outros
HUMAN_IN_LOOP=false
WANDB_ON=false
