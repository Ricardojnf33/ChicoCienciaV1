# --- LLM/VLM ---
# Necessário para usar CrewAI de forma real (sem dry-run)
OPENAI_API_KEY=""
MODEL_TEXT="gpt-4.1-mini"
MODEL_VISION="gpt-4o-mini"

# --- Literatura ---
# Opcional, mas recomendado para enriquecer buscas
SEMANTIC_SCHOLAR_API_KEY=""

SEMANTIC_SCHOLAR_RATE_LIMIT=1.1
SEMANTIC_SCHOLAR_CACHE_TTL=3600

# --- Busca agentic (ATS) ---
# Constante de exploração do UCT (ajuste fino)
UCT_C=1.414
# Critério de parada antecipada baseado no melhor score
EARLY_STOP_SCORE=0.72
# Limites do espaço de busca (usado por componentes futuros)
MAX_BRANCHING=3
MAX_DEPTH=4

# --- I/O ---
# Diretórios para dados e artefatos
DATA_ROOT="./data"
ARTIFACT_ROOT="./experiments"
# Banco SQLite para persistência dos nós (SQLModel)
SQLITE_URL="sqlite:///runs.db"

# --- Execução / Tracking ---
# Controle de intervenção humana
HUMAN_IN_LOOP=false
# Integração opcional com Weights & Biases
WANDB_ON=false
WANDB_PROJECT="ChicoCienciaV1"
WANDB_API_KEY=""